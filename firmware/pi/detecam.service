# DeteCam 수신기 혼자 동작: 파이를 켜면 node.py 가 뜬다.  설치는 install.sh 가 한다.
[Unit]
Description=DeteCam receiver (standalone node)
After=network.target

[Service]
User=pi
WorkingDirectory=/home/pi/detecam
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/pi/detecam/node.py --port 80
# 80번 포트를 root 가 아닌 사용자로 연다
AmbientCapabilities=CAP_NET_BIND_SERVICE
# 멈출 때(끄기 버튼 포함) 캡처를 끄고 모터 전류를 끊는다
ExecStopPost=-/usr/bin/sudo /usr/bin/pkill -x tcpdump
ExecStopPost=-/usr/bin/python3 /home/pi/detecam/rx3.py release
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
